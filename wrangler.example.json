{
  "name": "cinemax-backend-proxy",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    "focusflow.id.vn/api/*",
    "focusflow.id.vn/tmdb/*",
    "focusflow.id.vn/img/*"
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "GEMINI_API_KEY": "YOUR_GEMINI_API_KEY",
    "SUBDL_API_KEY": "YOUR_SUBDL_API_KEY",
    "TMDB_ACCESS_TOKEN": "YOUR_TMDB_ACCESS_TOKEN",
    "VITE_SUBTITLE_ADDONS": "stremio://opensubtitles-v3.strem.io/manifest.json",
    "HOLLYSHEESH_API_URL": "https://hollysheesh-bridge.onrender.com"
  }
}
